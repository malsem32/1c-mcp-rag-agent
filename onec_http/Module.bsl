Функция ПредставлениеОписанияТипов(ОписаниеТипов)

	// Читаемый тип: «Строка», «Справочник.Контрагенты», «Документ.Реализация…»
	// (Строка(ОписаниеТипов) часто бесполезна для модели)

	Если ОписаниеТипов = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;

	Попытка
		Для Каждого Т Из ОписаниеТипов.Типы() Цикл

			Предст = "";
			Попытка
				МетаТипа = Метаданные.НайтиПоТипу(Т);
				Если МетаТипа <> Неопределено Тогда
					Предст = МетаТипа.ПолноеИмя();
				КонецЕсли;
			Исключение
			КонецПопытки;

			Если Не ЗначениеЗаполнено(Предст) Тогда
				Попытка
					Предст = Строка(Т);
				Исключение
					Предст = "";
				КонецПопытки;
			КонецЕсли;

			// XML-имя: CatalogRef.X → оставляем как есть, если нет мета
			Если Не ЗначениеЗаполнено(Предст) Тогда
				Попытка
					Х = XMLТип(Т);
					Если Х <> Неопределено Тогда
						Предст = Х.TypeName;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;

			Если ЗначениеЗаполнено(Предст) И Части.Найти(Предст) = Неопределено Тогда
				Части.Добавить(Предст);
			КонецЕсли;

		КонецЦикла;
	Исключение
	КонецПопытки;

	Если Части.Количество() = 0 Тогда
		Попытка
			Возврат СокрЛП(Строка(ОписаниеТипов));
		Исключение
			Возврат "";
		КонецПопытки;
	КонецЕсли;

	Возврат СтрСоединить(Части, " | ");

КонецФункции

Функция ОписаниеПоля(Рекв, Вид)

	О = Новый Структура;
	О.Вставить("kind", Вид);
	О.Вставить("name", Рекв.Имя);

	Попытка
		О.Вставить("synonym", Строка(Рекв.Синоним));
	Исключение
		О.Вставить("synonym", "");
	КонецПопытки;

	ТипСтр = "";
	Попытка
		ТипСтр = ПредставлениеОписанияТипов(Рекв.Тип);
	Исключение
		ТипСтр = "";
	КонецПопытки;
	Если Не ЗначениеЗаполнено(ТипСтр) Тогда
		Попытка
			ТипСтр = СокрЛП(Строка(Рекв.Тип));
		Исключение
			ТипСтр = "";
		КонецПопытки;
	КонецЕсли;
	О.Вставить("type", ТипСтр);
	О.Вставить("тип", ТипСтр); // дубль по-русски для модели

	Возврат О;

КонецФункции


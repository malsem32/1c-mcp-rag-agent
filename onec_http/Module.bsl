// ============================================================================
// HTTP-сервис AI для rag_agent / LM Studio
//
// РЕКОМЕНДУЕМАЯ НАСТРОЙКА (чтобы не было «Обработчик запроса не найден»):
//
//   HTTP-сервис:
//     Имя: AI
//     Корневой URL: ai
//
//   Шаблон URL №1:
//     Шаблон: *
//     Методы:
//       GET  → ОбработчикGET
//       POST → ОбработчикPOST
//
// Пути (после публикации):
//   GET  .../hs/ai/list
//   GET  .../hs/ai/object?name=Справочник.Контрагенты
//   GET  .../hs/ai/info
//   GET  .../hs/ai/search?q=контраг
//   POST .../hs/ai/query
//   POST .../hs/ai/eventlog   — журнал регистрации (фильтр + limit)
//   GET  .../hs/ai/sessions   — активные сеансы / пользователи ИБ
//
// type= также: ОбщиеМодули | ОбщиеФормы | Отчеты | Обработки
// (имена метаданных; текст BSL runtime не отдаёт — нужен dump + search_code)
//
// АЛЬТЕРНАТИВА: + eventlogPOST, sessionsGET
// ============================================================================

#Область ПрограммныйИнтерфейс

// ===== Универсальные обработчики для шаблона "*" =====

Функция ОбработчикGET(Запрос) Экспорт

	Путь = НормализоватьПуть(Запрос);

	Если Путь = "" Или Путь = "info" Тогда
		Возврат infoGET(Запрос);
	ИначеЕсли Путь = "list" Тогда
		Возврат listGET(Запрос);
	ИначеЕсли Путь = "object" Тогда
		Возврат objectGET(Запрос);
	ИначеЕсли Путь = "search" Тогда
		Возврат searchGET(Запрос);
	ИначеЕсли Путь = "sessions" Или Путь = "activeusers" Или Путь = "connections" Тогда
		Возврат sessionsGET(Запрос);
	ИначеЕсли Путь = "query" Тогда
		Возврат ОтветОшибка(405, "Метод query только POST. Используйте POST .../query");
	ИначеЕсли Путь = "eventlog" Тогда
		Возврат ОтветОшибка(405, "Метод eventlog только POST. Используйте POST .../eventlog");
	Иначе
		Возврат ОтветОшибка(404,
			"Неизвестный путь GET: '" + Путь + "'. Допустимо: list, object, info, search, sessions");
	КонецЕсли;

КонецФункции

Функция ОбработчикPOST(Запрос) Экспорт

	Путь = НормализоватьПуть(Запрос);

	Если Путь = "query" Тогда
		Возврат queryPOST(Запрос);
	ИначеЕсли Путь = "eventlog" Или Путь = "journal" Или Путь = "log" Тогда
		Возврат eventlogPOST(Запрос);
	Иначе
		Возврат ОтветОшибка(404,
			"Неизвестный путь POST: '" + Путь + "'. Допустимо: query, eventlog");
	КонецЕсли;

КонецФункции

// Алиасы на случай другого имени в конфигураторе
Функция AI_GET(Запрос) Экспорт
	Возврат ОбработчикGET(Запрос);
КонецФункции

Функция AI_POST(Запрос) Экспорт
	Возврат ОбработчикPOST(Запрос);
КонецФункции

// ===== Отдельные обработчики (если делаете 5 шаблонов) =====

Функция listGET(Запрос) Экспорт

	Попытка

		ТипФильтр = ВРег(СокрЛП(ПараметрЗапроса(Запрос, "type")));
		Результат = Новый Структура;

		БогатыйФормат = НРег(ПараметрЗапроса(Запрос, "rich")) = "1"
			Или НРег(ПараметрЗапроса(Запрос, "rich")) = "true"
			Или НРег(ПараметрЗапроса(Запрос, "format")) = "rich";

		Если Не ЗначениеЗаполнено(ТипФильтр)
			Или ТипФильтр = "ВСЕ"
			Или ТипФильтр = "ALL" Тогда

			Если БогатыйФормат Тогда
				Результат.Вставить("Справочники", ОбъектыКоллекции(Метаданные.Справочники, "Справочник"));
				Результат.Вставить("Документы", ОбъектыКоллекции(Метаданные.Документы, "Документ"));
				Результат.Вставить("РегистрыСведений", ОбъектыКоллекции(Метаданные.РегистрыСведений, "РегистрСведений"));
				Результат.Вставить("РегистрыНакопления", ОбъектыКоллекции(Метаданные.РегистрыНакопления, "РегистрНакопления"));
				Результат.Вставить("Перечисления", ОбъектыКоллекции(Метаданные.Перечисления, "Перечисление"));
				Результат.Вставить("ПланыВидовХарактеристик", ОбъектыКоллекции(Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик"));
			Иначе
				Результат.Вставить("Справочники", ИменаКоллекции(Метаданные.Справочники));
				Результат.Вставить("Документы", ИменаКоллекции(Метаданные.Документы));
				Результат.Вставить("РегистрыСведений", ИменаКоллекции(Метаданные.РегистрыСведений));
				Результат.Вставить("РегистрыНакопления", ИменаКоллекции(Метаданные.РегистрыНакопления));
				Результат.Вставить("Перечисления", ИменаКоллекции(Метаданные.Перечисления));
				Результат.Вставить("ПланыВидовХарактеристик", ИменаКоллекции(Метаданные.ПланыВидовХарактеристик));
			КонецЕсли;

			ДобавитьОпциональнуюКоллекцию(Результат, "ПланыСчетов", "ПланСчетов", БогатыйФормат);
			ДобавитьОпциональнуюКоллекцию(Результат, "БизнесПроцессы", "БизнесПроцесс", БогатыйФормат);
			ДобавитьОпциональнуюКоллекцию(Результат, "Задачи", "Задача", БогатыйФормат);
			ДобавитьОпциональнуюКоллекцию(Результат, "ОбщиеМодули", "ОбщийМодуль", БогатыйФормат);
			ДобавитьОпциональнуюКоллекцию(Результат, "ОбщиеФормы", "ОбщаяФорма", БогатыйФормат);
			ДобавитьОпциональнуюКоллекцию(Результат, "Отчеты", "Отчет", БогатыйФормат);
			ДобавитьОпциональнуюКоллекцию(Результат, "Обработки", "Обработка", БогатыйФормат);

		Иначе

			Коллекция = КоллекцияМетаданныхПоИмени(ТипФильтр);
			Если Коллекция = Неопределено Тогда
				Возврат ОтветОшибка(400, "Неизвестный type: " + ТипФильтр);
			КонецЕсли;

			Ключ = НормализоватьИмяКласса(ТипФильтр);
			Префикс = ПрефиксЗапросаПоКлассу(Ключ);

			Если БогатыйФормат Тогда
				Объекты = ОбъектыКоллекции(Коллекция, Префикс);
			Иначе
				Объекты = ИменаКоллекции(Коллекция);
			КонецЕсли;

			Результат.Вставить(Ключ, Объекты);
			Результат.Вставить("type", Ключ);
			Результат.Вставить("count", Объекты.Количество());
			Результат.Вставить("objects", Объекты);

		КонецЕсли;

		Результат.Вставить("universal", Истина);
		Результат.Вставить("hint", "object?name=Тип.Имя | search?q= | POST query | list?rich=1");

		Возврат ОтветJSON(200, Результат);

	Исключение
		Возврат ОтветОшибка(500, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция objectGET(Запрос) Экспорт

	Попытка

		ИмяОбъекта = ПараметрЗапроса(Запрос, "name");
		Если Не ЗначениеЗаполнено(ИмяОбъекта) Тогда
			ИмяОбъекта = ПараметрЗапроса(Запрос, "Name");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИмяОбъекта) Тогда
			ИмяОбъекта = ПараметрЗапроса(Запрос, "full_name");
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ИмяОбъекта) Тогда
			Возврат ОтветОшибка(400,
				"Не передан параметр name. Пример: object?name=Справочник.Номенклатура");
		КонецЕсли;

		ИмяОбъекта = НормализоватьПолноеИмя(ИмяОбъекта);

		Мета = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
		Если Мета = Неопределено Тогда
			Возврат ОтветОшибка(404, "Объект метаданных не найден: " + ИмяОбъекта);
		КонецЕсли;

		Инфо = Новый Структура;
		Инфо.Вставить("full_name", Мета.ПолноеИмя());
		Инфо.Вставить("name", Мета.Имя);
		Инфо.Вставить("synonym", Строка(Мета.Синоним));

		Попытка
			Инфо.Вставить("comment", Строка(Мета.Комментарий));
		Исключение
			Инфо.Вставить("comment", "");
		КонецПопытки;

		Инфо.Вставить("attributes", СобратьВсеРеквизиты(Мета));
		Инфо.Вставить("tabular_sections", СобратьТЧ(Мета));
		Инфо.Вставить("dimensions", СобратьИзмерения(Мета));
		Инфо.Вставить("resources", СобратьРесурсы(Мета));

		// Формы / макеты / команды — фактические имена из метаданных конфигурации
		Инфо.Вставить("forms", СобратьФормыОбъекта(Мета));
		Инфо.Вставить("templates", СобратьМакетыОбъекта(Мета));
		Инфо.Вставить("commands", СобратьКомандыОбъекта(Мета));
		Инфо.Вставить("default_forms", СобратьФормыПоУмолчанию(Мета));

		// состав подсистемы
		Если СтрНачинаетсяС(ВРег(ИмяОбъекта), "ПОДСИСТЕМА.") Тогда
			Инфо.Вставить("content", СобратьСоставПодсистемы(Мета));
			Инфо.Вставить("child_subsystems", СобратьДочерниеПодсистемы(Мета));
		КонецЕсли;

		Если СтрНачинаетсяС(ВРег(ИмяОбъекта), "ПЕРЕЧИСЛЕНИЕ.") Тогда
			Инфо.Вставить("enum_values", СобратьЗначенияПеречисления(Мета));
		КонецЕсли;

		Возврат ОтветJSON(200, Инфо);

	Исключение
		Возврат ОтветОшибка(500, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция infoGET(Запрос) Экспорт

	Попытка

		Инфо = Новый Структура;
		Инфо.Вставить("status", "ok");
		Инфо.Вставить("backend", "http");
		Инфо.Вставить("config_name", Метаданные.Имя);
		Инфо.Вставить("config_synonym", Строка(Метаданные.Синоним));
		Инфо.Вставить("config_version", Строка(Метаданные.Версия));
		Инфо.Вставить("platform", "1C:Enterprise");
		Инфо.Вставить("endpoints", "list, object, query (params), info, search, sessions, eventlog");
		Инфо.Вставить("code_note",
			"Текст модулей BSL runtime не отдаётся. Для search_code нужна выгрузка конфигурации в файлы.");

		Возврат ОтветJSON(200, Инфо);

	Исключение
		Возврат ОтветОшибка(500, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция searchGET(Запрос) Экспорт

	Попытка

		СтрокаПоиска = СокрЛП(ПараметрЗапроса(Запрос, "q"));
		Если Не ЗначениеЗаполнено(СтрокаПоиска) Тогда
			СтрокаПоиска = СокрЛП(ПараметрЗапроса(Запрос, "search_query"));
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаПоиска) Тогда
			СтрокаПоиска = СокрЛП(ПараметрЗапроса(Запрос, "query"));
		КонецЕсли;

		ТипФильтр = СокрЛП(ПараметрЗапроса(Запрос, "type"));
		Если Не ЗначениеЗаполнено(ТипФильтр) Тогда
			ТипФильтр = "Все";
		КонецЕсли;

		Лимит = ЧислоИзПараметра(ПараметрЗапроса(Запрос, "limit"), 50);
		Если Лимит < 1 Тогда
			Лимит = 1;
		ИначеЕсли Лимит > 200 Тогда
			Лимит = 200;
		КонецЕсли;

		Результаты = Новый Массив;
		СтрокаПоискаНРег = НРег(СтрокаПоиска);

		Классы = КлассыДляПоиска(ТипФильтр);

		Для Каждого ОписаниеКласса Из Классы Цикл

			Если Результаты.Количество() >= Лимит Тогда
				Прервать;
			КонецЕсли;

			Коллекция = ОписаниеКласса.Коллекция;
			Префикс = ОписаниеКласса.Префикс;
			ИмяКласса = ОписаниеКласса.ИмяКласса;

			Если Коллекция = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого Эл Из Коллекция Цикл

				Если Результаты.Количество() >= Лимит Тогда
					Прервать;
				КонецЕсли;

				ИмяЭл = Эл.Имя;
				СинонимЭл = Строка(Эл.Синоним);

				Если ЗначениеЗаполнено(СтрокаПоискаНРег) Тогда
					Если СтрНайти(НРег(ИмяЭл), СтрокаПоискаНРег) = 0
						И СтрНайти(НРег(СинонимЭл), СтрокаПоискаНРег) = 0 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;

				Запись = Новый Структура;
				Запись.Вставить("full_name", Префикс + "." + ИмяЭл);
				Запись.Вставить("name", ИмяЭл);
				Запись.Вставить("synonym", СинонимЭл);
				Запись.Вставить("type", ИмяКласса);
				Результаты.Добавить(Запись);

			КонецЦикла;

		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("search_query", СтрокаПоиска);
		Ответ.Вставить("object_type", ТипФильтр);
		Ответ.Вставить("found_count", Результаты.Количество());
		Ответ.Вставить("results", Результаты);
		Ответ.Вставить("source", "http_search");

		Возврат ОтветJSON(200, Ответ);

	Исключение
		Возврат ОтветОшибка(500, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция queryPOST(Запрос) Экспорт

	Попытка

		Тело = Запрос.ПолучитьТелоКакСтроку();
		Если Не ЗначениеЗаполнено(Тело) Тогда
			Возврат ОтветОшибка(400,
				"Пустое тело. JSON: {""query"":""ВЫБРАТЬ ..."", ""limit"":50}");
		КонецЕсли;

		Данные = ПрочитатьJSONВСоответствие(Тело);
		Если Данные = Неопределено Тогда
			Возврат ОтветОшибка(400, "Не удалось разобрать JSON тела запроса");
		КонецЕсли;

		ТекстЗапроса = СтрокаИзСоответствия(Данные, "query");
		Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
			ТекстЗапроса = СтрокаИзСоответствия(Данные, "Query");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
			ТекстЗапроса = СтрокаИзСоответствия(Данные, "text");
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
			Возврат ОтветОшибка(400, "В JSON нет поля query");
		КонецЕсли;

		// AI/MCP часто присылают литералы \n \t — 1С их не понимает
		ТекстЗапроса = НормализоватьТекстЗапроса1С(ТекстЗапроса);

		Лимит = ЧислоИзПараметра(СтрокаИзСоответствия(Данные, "limit"), 50);
		Если Лимит < 1 Тогда
			Лимит = 1;
		ИначеЕсли Лимит > 300 Тогда
			Лимит = 300;
		КонецЕсли;

		Проверка = ПроверитьЗапросТолькоЧтение(ТекстЗапроса);
		Если Не Проверка.Ок Тогда
			Возврат ОтветОшибка(400, Проверка.Ошибка);
		КонецЕсли;

		Запрос1С = Новый Запрос;
		Запрос1С.Текст = ТекстЗапроса;

		// H3: параметры {"params": {"Д": "2016-01-01", "Ссылка": {"type": "Справочник.X", "uuid": "…"}}}
		Параметры = Неопределено;
		Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
			Параметры = Данные.Получить("params");
		КонецЕсли;
		Если ТипЗнч(Параметры) = Тип("Соответствие") Тогда
			Для Каждого КЗ Из Параметры Цикл
				Запрос1С.УстановитьПараметр(КЗ.Ключ, ЗначениеПараметраИзJSON(КЗ.Значение));
			КонецЦикла;
		КонецЕсли;

		РезультатЗапроса = Запрос1С.Выполнить();

		Колонки = Новый Массив;
		Для Каждого Кол Из РезультатЗапроса.Колонки Цикл
			Колонки.Добавить(Кол.Имя);
		КонецЦикла;

		// H4: читаем выборкой только Лимит+1 строк (не Выгрузить() всей таблицы)
		Строки = Новый Массив;
		Сч = 0;
		Обрезано = Ложь;
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл

			Если Сч >= Лимит Тогда
				Обрезано = Истина;
				Прервать;
			КонецЕсли;

			Запись = Новый Структура;
			Для Каждого ИмяКол Из Колонки Цикл
				Запись.Вставить(ИмяКол, ЗначениеДляJSON(Выборка[ИмяКол]));
			КонецЦикла;
			Строки.Добавить(Запись);
			Сч = Сч + 1;

		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("columns", Колонки);
		Ответ.Вставить("data", Строки);
		Ответ.Вставить("rows", Строки);
		Ответ.Вставить("rows_count", Строки.Количество());
		Ответ.Вставить("returned", Строки.Количество());
		Ответ.Вставить("truncated", Обрезано);
		Ответ.Вставить("limit", Лимит);

		Возврат ОтветJSON(200, Ответ);

	Исключение
		Возврат ОтветОшибка(400, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Журнал регистрации платформы 1С (не запрос ВЫБРАТЬ).
// POST JSON:
// {
//   "limit": 50,
//   "date_from": "2024-01-01T00:00:00",
//   "date_to": "2024-01-31T23:59:59",
//   "level": "Error|Warning|Information|Note|Ошибка|Предупреждение|Информация|Примечание",
//   "user": "ИмяПользователя",
//   "event": "подстрока события",
//   "application": "1CV8|BackgroundJob|...",
//   "comment": "подстрока комментария",
//   "metadata": "подстрока метаданных"
// }
//
// Активные сеансы / пользователи информационной базы
// GET .../sessions?app=1CV8&user=Имя
//
Функция sessionsGET(Запрос) Экспорт

	Попытка

		ФильтрПрил = НРег(СокрЛП(ПараметрЗапроса(Запрос, "app")));
		Если Не ЗначениеЗаполнено(ФильтрПрил) Тогда
			ФильтрПрил = НРег(СокрЛП(ПараметрЗапроса(Запрос, "application")));
		КонецЕсли;
		ФильтрПольз = НРег(СокрЛП(ПараметрЗапроса(Запрос, "user")));
		Если Не ЗначениеЗаполнено(ФильтрПольз) Тогда
			ФильтрПольз = НРег(СокрЛП(ПараметрЗапроса(Запрос, "пользователь")));
		КонецЕсли;
		ТолькоУник = НРег(ПараметрЗапроса(Запрос, "unique")) = "1"
			Или НРег(ПараметрЗапроса(Запрос, "unique")) = "true"
			Или НРег(ПараметрЗапроса(Запрос, "distinct_users")) = "1";

		СеансыМассив = Новый Массив;
		ПользователиУник = Новый Соответствие;
		ПоПриложениям = Новый Соответствие;

		Попытка
			Сеансы = ПолучитьСеансыИнформационнойБазы();
		Исключение
			// fallback: соединения
			Попытка
				Сеансы = ПолучитьСоединенияИнформационнойБазы();
			Исключение
				Возврат ОтветОшибка(500,
					"Не удалось получить сеансы ИБ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
					+ ". Нужны права администрирования / просмотр списка активных пользователей.");
			КонецПопытки;
		КонецПопытки;

		Для Каждого С Из Сеансы Цикл

			ИмяПольз = "";
			ИмяПрил = "";
			Комп = "";
			НомерСеанса = 0;
			Начало = "";
			Соединение = 0;
			IP = "";

			Попытка
				ИмяПольз = Строка(С.UserName);
			Исключение
				Попытка
					ИмяПольз = Строка(С.User);
				Исключение
					ИмяПольз = "";
				КонецПопытки;
			КонецПопытки;

			Попытка
				ИмяПрил = Строка(С.ApplicationName);
			Исключение
				Попытка
					ИмяПрил = Строка(С.AppID);
				Исключение
					ИмяПрил = "";
				КонецПопытки;
			КонецПопытки;

			Попытка
				Комп = Строка(С.ComputerName);
			Исключение
				Комп = "";
			КонецПопытки;

			Попытка
				НомерСеанса = С.SessionNumber;
			Исключение
				Попытка
					НомерСеанса = С.НомерСеанса;
				Исключение
					НомерСеанса = 0;
				КонецПопытки;
			КонецПопытки;

			Попытка
				Начало = Формат(С.SessionStarted, "ДФ=yyyy-MM-ddTHH:mm:ss");
			Исключение
				Попытка
					Начало = Формат(С.НачалоСеанса, "ДФ=yyyy-MM-ddTHH:mm:ss");
				Исключение
					Начало = "";
				КонецПопытки;
			КонецПопытки;

			Попытка
				Соединение = С.ConnectionNumber;
			Исключение
				Соединение = 0;
			КонецПопытки;

			Попытка
				IP = Строка(С.ClientIPAddress);
			Исключение
				IP = "";
			КонецПопытки;

			Если ЗначениеЗаполнено(ФильтрПрил) И СтрНайти(НРег(ИмяПрил), ФильтрПрил) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(ФильтрПольз) И СтрНайти(НРег(ИмяПольз), ФильтрПольз) = 0 Тогда
				Продолжить;
			КонецЕсли;

			Запись = Новый Структура;
			Запись.Вставить("user", ИмяПольз);
			Запись.Вставить("application", ИмяПрил);
			Запись.Вставить("computer", Комп);
			Запись.Вставить("session", НомерСеанса);
			Запись.Вставить("started", Начало);
			Запись.Вставить("connection", Соединение);
			Запись.Вставить("ip", IP);

			КлючПольз = ?(ЗначениеЗаполнено(ИмяПольз), ИмяПольз, "(пусто)");
			КлючПрил = ?(ЗначениеЗаполнено(ИмяПрил), ИмяПрил, "(пусто)");

			Если ТолькоУник Тогда
				Если ПользователиУник.Получить(КлючПольз) = Неопределено Тогда
					ПользователиУник.Вставить(КлючПольз, Истина);
					СеансыМассив.Добавить(Запись);
				КонецЕсли;
			Иначе
				СеансыМассив.Добавить(Запись);
			КонецЕсли;

			ПоПриложениям.Вставить(КлючПрил,
				?(ПоПриложениям.Получить(КлючПрил) = Неопределено, 0, ПоПриложениям.Получить(КлючПрил)) + 1);
			Если Не ТолькоУник Тогда
				// для by_user считаем все сеансы
			КонецЕсли;

		КонецЦикла;

		// by_user из полного списка (пересчёт)
		ПоПользователям = Новый Соответствие;
		Для Каждого З Из СеансыМассив Цикл
			К = ?(ЗначениеЗаполнено(З.user), З.user, "(пусто)");
			ПоПользователям.Вставить(К,
				?(ПоПользователям.Получить(К) = Неопределено, 0, ПоПользователям.Получить(К)) + 1);
		КонецЦикла;

		// уникальные имена
		УникИмена = Новый Массив;
		Для Каждого КЗ Из ПоПользователям Цикл
			УникИмена.Добавить(КЗ.Ключ);
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("source", "infobase_sessions");
		Ответ.Вставить("sessions_count", СеансыМассив.Количество());
		Ответ.Вставить("unique_users_count", УникИмена.Количество());
		Ответ.Вставить("sessions", СеансыМассив);
		Ответ.Вставить("users", УникИмена);
		Ответ.Вставить("by_user", СоответствиеВМассивПар(ПоПользователям));
		Ответ.Вставить("by_application", СоответствиеВМассивПар(ПоПриложениям));
		Ответ.Вставить("unique", ТолькоУник);
		Ответ.Вставить("hint",
			"Активные сеансы ИБ (ПолучитьСеансыИнформационнойБазы). "
			+ "Справочник.Пользователи — list_users. Роли — list_roles.");

		Возврат ОтветJSON(200, Ответ);

	Исключение
		Возврат ОтветОшибка(500, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция eventlogPOST(Запрос) Экспорт

	Попытка

		Тело = Запрос.ПолучитьТелоКакСтроку();
		Данные = Неопределено;
		Если ЗначениеЗаполнено(Тело) Тогда
			Данные = ПрочитатьJSONВСоответствие(Тело);
		КонецЕсли;
		Если Данные = Неопределено Тогда
			Данные = Новый Соответствие;
		КонецЕсли;

		Лимит = ЧислоИзПараметра(СтрокаИзСоответствия(Данные, "limit"), 50);
		Если Лимит < 1 Тогда
			Лимит = 1;
		ИначеЕсли Лимит > 500 Тогда
			Лимит = 500;
		КонецЕсли;

		// Фильтр журнала
		Фильтр = Новый Структура;

		ДатаНач = ДатаИзПараметраЖР(СтрокаИзСоответствия(Данные, "date_from"));
		Если ДатаНач = Неопределено Тогда
			ДатаНач = ДатаИзПараметраЖР(СтрокаИзСоответствия(Данные, "start"));
		КонецЕсли;
		Если ДатаНач = Неопределено Тогда
			// по умолчанию — последние 7 дней
			ДатаНач = НачалоДня(ТекущаяДатаСеанса() - 7 * 24 * 60 * 60);
		КонецЕсли;
		Фильтр.Вставить("StartDate", ДатаНач);
		Фильтр.Вставить("ДатаНачала", ДатаНач);

		ДатаКон = ДатаИзПараметраЖР(СтрокаИзСоответствия(Данные, "date_to"));
		Если ДатаКон = Неопределено Тогда
			ДатаКон = ДатаИзПараметраЖР(СтрокаИзСоответствия(Данные, "end"));
		КонецЕсли;
		Если ДатаКон = Неопределено Тогда
			ДатаКон = КонецДня(ТекущаяДатаСеанса());
		КонецЕсли;
		Фильтр.Вставить("EndDate", ДатаКон);
		Фильтр.Вставить("ДатаОкончания", ДатаКон);

		УровеньСтр = СокрЛП(СтрокаИзСоответствия(Данные, "level"));
		Если Не ЗначениеЗаполнено(УровеньСтр) Тогда
			УровеньСтр = СокрЛП(СтрокаИзСоответствия(Данные, "severity"));
		КонецЕсли;
		УровеньЖР = УровеньЖРИзСтроки(УровеньСтр);
		Если УровеньЖР <> Неопределено Тогда
			Фильтр.Вставить("Level", УровеньЖР);
			Фильтр.Вставить("Уровень", УровеньЖР);
		КонецЕсли;

		ПользовательСтр = СокрЛП(СтрокаИзСоответствия(Данные, "user"));
		Если Не ЗначениеЗаполнено(ПользовательСтр) Тогда
			ПользовательСтр = СокрЛП(СтрокаИзСоответствия(Данные, "пользователь"));
		КонецЕсли;
		Если ЗначениеЗаполнено(ПользовательСтр) Тогда
			Фильтр.Вставить("User", ПользовательСтр);
			Фильтр.Вставить("Пользователь", ПользовательСтр);
		КонецЕсли;

		Приложение = СокрЛП(СтрокаИзСоответствия(Данные, "application"));
		Если ЗначениеЗаполнено(Приложение) Тогда
			Фильтр.Вставить("ApplicationName", Приложение);
			Фильтр.Вставить("ИмяПриложения", Приложение);
		КонецЕсли;

		// Выгрузка в таблицу значений
		Таблица = Новый ТаблицаЗначений;

		Попытка
			// Платформа: ВыгрузитьЖурналРегистрации(<ТЗ>, <Фильтр>, , <МаксКол>)
			ВыгрузитьЖурналРегистрации(Таблица, Фильтр, , Лимит);
		Исключение
			// альтернативная сигнатура / права
			Попытка
				ВыгрузитьЖурналРегистрации(Таблица, Фильтр);
			Исключение
				Возврат ОтветОшибка(500,
					"Журнал регистрации недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
					+ ". Нужны права на просмотр журнала у пользователя HTTP-сервиса.");
			КонецПопытки;
		КонецПопытки;

		// пост-фильтры (событие / комментарий / метаданные — подстрока)
		СобытиеФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "event")));
		Если Не ЗначениеЗаполнено(СобытиеФильтр) Тогда
			СобытиеФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "событие")));
		КонецЕсли;
		КомментФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "comment")));
		Если Не ЗначениеЗаполнено(КомментФильтр) Тогда
			КомментФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "комментарий")));
		КонецЕсли;
		МетаФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "metadata")));
		Если Не ЗначениеЗаполнено(МетаФильтр) Тогда
			МетаФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "метаданные")));
		КонецЕсли;
		ТекстФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "q")));
		Если Не ЗначениеЗаполнено(ТекстФильтр) Тогда
			ТекстФильтр = НРег(СокрЛП(СтрокаИзСоответствия(Данные, "search")));
		КонецЕсли;

		КолонкиИмена = Новый Массив;
		Для Каждого Кол Из Таблица.Колонки Цикл
			КолонкиИмена.Добавить(Кол.Имя);
		КонецЦикла;

		Строки = Новый Массив;
		Сч = 0;
		ВсегоСырых = Таблица.Количество();

		Для Каждого СтрТЗ Из Таблица Цикл

			Если Сч >= Лимит Тогда
				Прервать;
			КонецЕсли;

			// собрать поля
			СобытиеЗн = "";
			КомментЗн = "";
			МетаЗн = "";
			ПользовательЗн = "";
			УровеньЗн = "";
			ДатаЗн = "";
			ПриложЗн = "";
			ДанныеЗн = "";

			Запись = Новый Структура;
			Для Каждого ИмяКол Из КолонкиИмена Цикл
				Зн = СтрТЗ[ИмяКол];
				ЗнJson = ЗначениеДляJSON(Зн);
				Запись.Вставить(ИмяКол, ЗнJson);

				ИмяН = НРег(ИмяКол);
				Если ИмяН = "event" Или ИмяН = "событие" Тогда
					СобытиеЗн = НРег(Строка(ЗнJson));
				ИначеЕсли ИмяН = "comment" Или ИмяН = "комментарий" Тогда
					КомментЗн = НРег(Строка(ЗнJson));
				ИначеЕсли ИмяН = "metadata" Или ИмяН = "метаданные" Тогда
					МетаЗн = НРег(Строка(ЗнJson));
				ИначеЕсли ИмяН = "user" Или ИмяН = "пользователь" Или ИмяН = "username" Тогда
					ПользовательЗн = Строка(ЗнJson);
				ИначеЕсли ИмяН = "level" Или ИмяН = "уровень" Тогда
					УровеньЗн = Строка(ЗнJson);
				ИначеЕсли ИмяН = "date" Или ИмяН = "дата" Тогда
					ДатаЗн = Строка(ЗнJson);
				ИначеЕсли ИмяН = "applicationname" Или ИмяН = "имяприложения" Или ИмяН = "application" Тогда
					ПриложЗн = Строка(ЗнJson);
				ИначеЕсли ИмяН = "data" Или ИмяН = "данные" Тогда
					ДанныеЗн = НРег(Строка(ЗнJson));
				КонецЕсли;
			КонецЦикла;

			// унифицированные поля для агента (поверх нативных имён колонок)
			Если Не ЗначениеЗаполнено(ДатаЗн) Тогда
				Попытка
					ДатаЗн = Строка(ЗначениеДляJSON(СтрТЗ.Date));
				Исключение
					ДатаЗн = "";
				КонецПопытки;
			КонецЕсли;
			Запись.Вставить("date", ДатаЗн);
			Запись.Вставить("level", УровеньЗн);
			Запись.Вставить("user", ПользовательЗн);
			Запись.Вставить("event", СобытиеЗн);
			Запись.Вставить("comment", КомментЗн);
			Запись.Вставить("metadata", МетаЗн);
			Запись.Вставить("application", ПриложЗн);

			Если ЗначениеЗаполнено(СобытиеФильтр) И СтрНайти(СобытиеЗн, СобытиеФильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(КомментФильтр) И СтрНайти(КомментЗн, КомментФильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(МетаФильтр) И СтрНайти(МетаЗн, МетаФильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекстФильтр) Тогда
				Блоб = СобытиеЗн + " " + КомментЗн + " " + МетаЗн + " " + ДанныеЗн + " " + НРег(ПользовательЗн);
				Если СтрНайти(Блоб, ТекстФильтр) = 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			Строки.Добавить(Запись);
			Сч = Сч + 1;

		КонецЦикла;

		// агрегаты для анализа
		ПоУровням = Новый Соответствие;
		ПоПользователям = Новый Соответствие;
		ПоСобытиям = Новый Соответствие;
		Для Каждого З Из Строки Цикл
			Ур = "";
			Пол = "";
			Соб = "";
			Если ТипЗнч(З) = Тип("Структура") Тогда
				Если З.Свойство("level") Тогда
					Ур = Строка(З.level);
				КонецЕсли;
				Если З.Свойство("user") Тогда
					Пол = Строка(З.user);
				КонецЕсли;
				Если З.Свойство("event") Тогда
					Соб = Строка(З.event);
				КонецЕсли;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Ур) Тогда
				Ур = "(пусто)";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Пол) Тогда
				Пол = "(пусто)";
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Соб) Тогда
				Соб = "(пусто)";
			КонецЕсли;
			ПоУровням.Вставить(Ур, ?(ПоУровням.Получить(Ур) = Неопределено, 0, ПоУровням.Получить(Ур)) + 1);
			ПоПользователям.Вставить(Пол, ?(ПоПользователям.Получить(Пол) = Неопределено, 0, ПоПользователям.Получить(Пол)) + 1);
			ПоСобытиям.Вставить(Соб, ?(ПоСобытиям.Получить(Соб) = Неопределено, 0, ПоСобытиям.Получить(Соб)) + 1);
		КонецЦикла;

		Ответ = Новый Структура;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("source", "event_log");
		Ответ.Вставить("date_from", Формат(ДатаНач, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		Ответ.Вставить("date_to", Формат(ДатаКон, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		Ответ.Вставить("limit", Лимит);
		Ответ.Вставить("raw_count", ВсегоСырых);
		Ответ.Вставить("rows_count", Строки.Количество());
		Ответ.Вставить("returned", Строки.Количество());
		Ответ.Вставить("truncated", ВсегоСырых > Строки.Количество());
		Ответ.Вставить("columns", КолонкиИмена);
		Ответ.Вставить("rows", Строки);
		Ответ.Вставить("data", Строки);
		Ответ.Вставить("by_level", СоответствиеВМассивПар(ПоУровням));
		Ответ.Вставить("by_user", СоответствиеВМассивПар(ПоПользователям));
		Ответ.Вставить("by_event", СоответствиеВМассивПар(ПоСобытиям));
		Ответ.Вставить("hint",
			"Журнал регистрации платформы. Фильтры: date_from/date_to, level, user, event, comment, metadata, q.");

		Возврат ОтветJSON(200, Ответ);

	Исключение
		Возврат ОтветОшибка(500, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции


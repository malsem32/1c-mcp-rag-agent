Функция КлассыДляПоиска(ТипФильтр)

	Результат = Новый Массив;
	Ключ = НормализоватьИмяКласса(ТипФильтр);

	Описания = Новый Массив;
	Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "Справочники", "Справочник", Метаданные.Справочники));
	Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "Документы", "Документ", Метаданные.Документы));
	Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "РегистрыСведений", "РегистрСведений", Метаданные.РегистрыСведений));
	Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "РегистрыНакопления", "РегистрНакопления", Метаданные.РегистрыНакопления));
	Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "Перечисления", "Перечисление", Метаданные.Перечисления));
	Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "ПланыВидовХарактеристик", "ПланВидовХарактеристик", Метаданные.ПланыВидовХарактеристик));

	// формы/модули — для «откуда данные в форме», без текста BSL
	Попытка
		Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "ОбщиеМодули", "ОбщийМодуль", Метаданные.ОбщиеМодули));
	Исключение
	КонецПопытки;
	Попытка
		Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "ОбщиеФормы", "ОбщаяФорма", Метаданные.ОбщиеФормы));
	Исключение
	КонецПопытки;
	Попытка
		Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "Отчеты", "Отчет", Метаданные.Отчеты));
	Исключение
	КонецПопытки;
	Попытка
		Описания.Добавить(Новый Структура("ИмяКласса, Префикс, Коллекция", "Обработки", "Обработка", Метаданные.Обработки));
	Исключение
	КонецПопытки;

	Если ВРег(Ключ) = "ВСЕ" Или Не ЗначениеЗаполнено(ТипФильтр) Или ВРег(ТипФильтр) = "ВСЕ" Тогда
		Возврат Описания;
	КонецЕсли;

	Для Каждого О Из Описания Цикл
		Если О.ИмяКласса = Ключ Тогда
			Результат.Добавить(О);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Возврат Описания;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СобратьФормыОбъекта(Мета)

	// Имена форм объекта (Справочник/Документ/…). Текст модуля — только из выгрузки BSL.
	Результат = Новый Массив;

	Попытка
		Если Мета.Формы = Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Попытка
		Для Каждого Ф Из Мета.Формы Цикл
			Запись = Новый Структура;
			Запись.Вставить("name", Ф.Имя);
			Попытка
				Запись.Вставить("synonym", Строка(Ф.Синоним));
			Исключение
				Запись.Вставить("synonym", "");
			КонецПопытки;
			Попытка
				Запись.Вставить("full_name", Ф.ПолноеИмя());
			Исключение
				Запись.Вставить("full_name", Мета.ПолноеИмя() + ".Форма." + Ф.Имя);
			КонецПопытки;
			Результат.Добавить(Запись);
			// Все формы объекта (имена любые, как в конфигураторе)
			Если Результат.Количество() >= 300 Тогда
				Прервать;
			КонецЕсли;

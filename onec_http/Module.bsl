Функция УровеньЖРИзСтроки(Стр)

	В = ВРег(СокрЛП(Стр));
	Если Не ЗначениеЗаполнено(В) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если В = "ERROR" Или В = "ОШИБКА" Или В = "ERR" Тогда
		Возврат УровеньЖурналаРегистрации.Ошибка;
	ИначеЕсли В = "WARNING" Или В = "ПРЕДУПРЕЖДЕНИЕ" Или В = "WARN" Тогда
		Возврат УровеньЖурналаРегистрации.Предупреждение;
	ИначеЕсли В = "INFORMATION" Или В = "ИНФОРМАЦИЯ" Или В = "INFO" Тогда
		Возврат УровеньЖурналаРегистрации.Информация;
	ИначеЕсли В = "NOTE" Или В = "ПРИМЕЧАНИЕ" Тогда
		Возврат УровеньЖурналаРегистрации.Примечание;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СоответствиеВМассивПар(Соотв)

	Рез = Новый Массив;
	Если Соотв = Неопределено Тогда
		Возврат Рез;
	КонецЕсли;

	Для Каждого КЗ Из Соотв Цикл
		Эл = Новый Структура;
		Эл.Вставить("key", Строка(КЗ.Ключ));
		Эл.Вставить("count", КЗ.Значение);
		Рез.Добавить(Эл);
	КонецЦикла;

	// сортировка по count убыв. — простая пузырьковая (массивы небольшие)
	н = Рез.Количество();
	Для и1 = 0 По н - 2 Цикл
		Для и2 = и1 + 1 По н - 1 Цикл
			Если Рез[и2].count > Рез[и1].count Тогда
				Вр = Рез[и1];
				Рез[и1] = Рез[и2];
				Рез[и2] = Вр;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// топ-30
	Пока Рез.Количество() > 30 Цикл
		Рез.Удалить(Рез.Количество() - 1);
	КонецЦикла;

	Возврат Рез;


Функция НормализоватьИмяКласса(ТипФильтр)

	В = ВРег(СокрЛП(ТипФильтр));

	Если В = "СПРАВОЧНИКИ" Или В = "СПРАВОЧНИК" Тогда
		Возврат "Справочники";
	ИначеЕсли В = "ДОКУМЕНТЫ" Или В = "ДОКУМЕНТ" Тогда
		Возврат "Документы";
	ИначеЕсли В = "РЕГИСТРЫСВЕДЕНИЙ" Или В = "РЕГИСТРСВЕДЕНИЙ" Тогда
		Возврат "РегистрыСведений";
	ИначеЕсли В = "РЕГИСТРЫНАКОПЛЕНИЯ" Или В = "РЕГИСТРНАКОПЛЕНИЯ" Тогда
		Возврат "РегистрыНакопления";
	ИначеЕсли В = "ПЕРЕЧИСЛЕНИЯ" Или В = "ПЕРЕЧИСЛЕНИЕ" Тогда
		Возврат "Перечисления";
	ИначеЕсли В = "ПЛАНЫВИДОВХАРАКТЕРИСТИК" Тогда
		Возврат "ПланыВидовХарактеристик";
	ИначеЕсли В = "ПЛАНЫСЧЕТОВ" Тогда
		Возврат "ПланыСчетов";
	ИначеЕсли В = "БИЗНЕСПРОЦЕССЫ" Тогда
		Возврат "БизнесПроцессы";
	ИначеЕсли В = "ЗАДАЧИ" Тогда
		Возврат "Задачи";
	ИначеЕсли В = "ОБЩИЕМОДУЛИ" Или В = "ОБЩИЙМОДУЛЬ" Или В = "COMMONMODULES" Тогда
		Возврат "ОбщиеМодули";
	ИначеЕсли В = "ОБЩИЕФОРМЫ" Или В = "ОБЩАЯФОРМА" Или В = "COMMONFORMS" Тогда
		Возврат "ОбщиеФормы";
	ИначеЕсли В = "ОТЧЕТЫ" Или В = "ОТЧЁТЫ" Или В = "ОТЧЕТ" Или В = "REPORTS" Тогда
		Возврат "Отчеты";
	ИначеЕсли В = "ОБРАБОТКИ" Или В = "ОБРАБОТКА" Или В = "DATAPROCESSORS" Тогда
		Возврат "Обработки";
	ИначеЕсли В = "ПОДСИСТЕМЫ" Или В = "ПОДСИСТЕМА" Или В = "SUBSYSTEMS" Тогда
		Возврат "Подсистемы";
	ИначеЕсли В = "РОЛИ" Или В = "РОЛЬ" Или В = "ROLES" Тогда
		Возврат "Роли";
	ИначеЕсли В = "КОНСТАНТЫ" Или В = "КОНСТАНТА" Или В = "CONSTANTS" Тогда
		Возврат "Константы";
	ИначеЕсли В = "ПАРАМЕТРЫСЕАНСА" Или В = "ПАРАМЕТРСЕАНСА" Или В = "SESSIONPARAMETERS" Тогда
		Возврат "ПараметрыСеанса";
	ИначеЕсли В = "ПЛАНЫОБМЕНА" Или В = "ПЛАНОБМЕНА" Или В = "EXCHANGEPLANS" Тогда
		Возврат "ПланыОбмена";
	ИначеЕсли В = "РЕГИСТРЫБУХГАЛТЕРИИ" Или В = "РЕГИСТРБУХГАЛТЕРИИ" Или В = "ACCOUNTINGREGISTERS" Тогда
		Возврат "РегистрыБухгалтерии";
	ИначеЕсли В = "ЖУРНАЛЫДОКУМЕНТОВ" Или В = "ЖУРНАЛДОКУМЕНТОВ" Или В = "DOCUMENTJOURNALS" Тогда
		Возврат "ЖурналыДокументов";
	ИначеЕсли В = "РЕГЛАМЕНТНЫЕЗАДАНИЯ" Или В = "РЕГЛАМЕНТНОЕЗАДАНИЕ" Или В = "SCHEDULEDJOBS" Тогда
		Возврат "РегламентныеЗадания";
	ИначеЕсли В = "HTTPSЕРВИСЫ" Или В = "HTTPSЕРВИС" Или В = "HTTPSERVICES" Тогда
		Возврат "HTTPСервисы";
	ИначеЕсли В = "ОБЩИЕКОМАНДЫ" Или В = "ОБЩАЯКОМАНДА" Или В = "COMMONCOMMANDS" Тогда
		Возврат "ОбщиеКоманды";
	ИначеЕсли В = "КРИТЕРИИОТБОРА" Или В = "КРИТЕРИЙОТБОРА" Или В = "FILTERCRITERIA" Тогда
		Возврат "КритерииОтбора";
	ИначеЕсли В = "ПОДПИСКИНАСОБЫТИЯ" Или В = "ПОДПИСКАНАСОБЫТИЕ" Или В = "EVENTSUBSCRIPTIONS" Тогда
		Возврат "ПодпискиНаСобытия";
	ИначеЕсли В = "ФУНКЦИОНАЛЬНЫЕОПЦИИ" Или В = "ФУНКЦИОНАЛЬНАЯОПЦИЯ" Или В = "FUNCTIONALOPTIONS" Тогда
		Возврат "ФункциональныеОпции";
	ИначеЕсли В = "ОПРЕДЕЛЯЕМЫЕТИПЫ" Или В = "ОПРЕДЕЛЯЕМЫЙТИП" Или В = "DEFINEDTYPES" Тогда
		Возврат "ОпределяемыеТипы";
	КонецЕсли;

	Возврат СокрЛП(ТипФильтр);

КонецФункции


Функция СобратьФормыПоУмолчанию(Мета)

	// Имена DefaultObjectForm / DefaultListForm / … как назначено в конфигураторе
	Результат = Новый Структура;
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("object", "ОсновнаяФормаОбъекта");
	// через попытки свойств метаданных платформы
	ИменаСвойств = Новый Массив;
	ИменаСвойств.Добавить("ОсновнаяФормаОбъекта");
	ИменаСвойств.Добавить("ОсновнаяФормаСписка");
	ИменаСвойств.Добавить("ОсновнаяФормаДляВыбора");
	ИменаСвойств.Добавить("ОсновнаяФормаГруппы");
	ИменаСвойств.Добавить("ОсновнаяФормаДляВыбораГруппы");
	ИменаСвойств.Добавить("ОсновнаяФормаЗаписи");
	ИменаСвойств.Добавить("ОсновнаяФормаНабораЗаписей");

	КлючиJSON = Новый Массив;
	КлючиJSON.Добавить("object");
	КлючиJSON.Добавить("list");
	КлючиJSON.Добавить("choice");
	КлючиJSON.Добавить("folder");
	КлючиJSON.Добавить("folder_choice");
	КлючиJSON.Добавить("record");
	КлючиJSON.Добавить("record_set");

	Для Индекс = 0 По ИменаСвойств.Количество() - 1 Цикл
		ИмяСвойства = ИменаСвойств[Индекс];
		Ключ = КлючиJSON[Индекс];
		Попытка
			Зн = Мета[ИмяСвойства];
			Если Зн <> Неопределено Тогда
				Попытка
					Результат.Вставить(Ключ, Зн.Имя);
				Исключение
					Попытка
						Стр = Строка(Зн);
						// Document.X.Form.Name → Name
						Части = СтрРазделить(Стр, ".");
						Если Части.Количество() > 0 Тогда
							Результат.Вставить(Ключ, Части[Части.Количество() - 1]);
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецПопытки;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции


Функция ДатаИзПараметраЖР(Стр)

	С = СокрЛП(Строка(Стр));
	Если Не ЗначениеЗаполнено(С) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// ISO: 2024-01-15T12:00:00 или 2024-01-15
	Попытка
		С2 = СтрЗаменить(С, "T", " ");
		С2 = СтрЗаменить(С2, "Z", "");
		Если СтрДлина(С2) = 10 Тогда
			// yyyy-MM-dd
			Возврат Дата(Число(Лев(С2, 4)), Число(Сред(С2, 6, 2)), Число(Прав(С2, 2)));
		КонецЕсли;
		// yyyy-MM-dd HH:mm:ss
		Если СтрДлина(С2) >= 19 Тогда
			Возврат Дата(
				Число(Лев(С2, 4)), Число(Сред(С2, 6, 2)), Число(Сред(С2, 9, 2)),
				Число(Сред(С2, 12, 2)), Число(Сред(С2, 15, 2)), Число(Сред(С2, 18, 2)));
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), С);
	Исключение
	КонецПопытки;

	Возврат Неопределено;


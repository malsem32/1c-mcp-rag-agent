// Извлекает "list" / "object" / "query" из URL запроса
//
Функция НормализоватьПуть(Запрос)

	Путь = "";

	// 1) Относительный URL HTTP-сервиса (предпочтительно)
	Попытка
		Путь = Строка(Запрос.ОтносительныйURL);
	Исключение
		Путь = "";
	КонецПопытки;

	// 2) Иногда путь в БазовыйURL / полный URL
	Если Не ЗначениеЗаполнено(Путь) Тогда
		Попытка
			Путь = Строка(Запрос.БазовыйURL);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Путь = СокрЛП(Путь);
	Путь = СтрЗаменить(Путь, "\", "/");

	// убрать query string
	ПозВопроса = СтрНайти(Путь, "?");
	Если ПозВопроса > 0 Тогда
		Путь = Лев(Путь, ПозВопроса - 1);
	КонецЕсли;

	// взять последний сегмент: .../hs/ai/list → list
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	ПозСлэш = СтрНайти(Путь, "/", НаправлениеПоиска.СКонца);
	Если ПозСлэш > 0 Тогда
		Путь = Сред(Путь, ПозСлэш + 1);
	КонецЕсли;

	Путь = НРег(СокрЛП(Путь));

	// если пришло "ai" (корень) — считаем info
	Если Путь = "ai" Или Путь = "hs" Тогда
		Путь = "";
	КонецЕсли;

	Возврат Путь;

КонецФункции

Функция СтрЗаканчиваетсяНа(Строка, Подстрока)

	Если СтрДлина(Строка) < СтрДлина(Подстрока) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Прав(Строка, СтрДлина(Подстрока)) = Подстрока;


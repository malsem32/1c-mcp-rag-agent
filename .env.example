# Секреты (не коммитить). Всё остальное — в config.yaml

# 1С HTTP (если пароль не в config.yaml)
# RAG_HTTP_PASSWORD=

# LLM
AIGATE_API_KEY=
# или:
# RAG_LLM_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Qdrant Cloud (только mode: url)
# QDRANT_API_KEY=

# Open WebUI: вложения чата (.epf/.erf/.cfe) для inspect_external_processing
# Ключ администратора: Settings -> Account -> API Keys
# OWUI_URL=http://localhost:3000
# OWUI_API_KEY=...

# MCP по HTTP (python main.py --transport http / scripts\mcp_http.py / кнопка в панели)
# 127.0.0.1 достаточно для Open WebUI в Docker Desktop (URL: http://host.docker.internal:8100/mcp).
# 0.0.0.0 — только вместе с RAG_MCP_TOKEN (без токена сервер не стартует).
# RAG_MCP_HOST=127.0.0.1
# RAG_MCP_PORT=8100
# Bearer-токен MCP (панель → «Сгенерировать токен MCP»); в Open WebUI: Auth = Bearer
# RAG_MCP_TOKEN=...
# Раздача Excel-файлов (8765 занят панелью)
# RAG_EXPORT_HTTP_PORT=8766

# Приём .epf/.erf из фильтра Open WebUI (POST /upload на MCP). Пусто — используется RAG_MCP_TOKEN;
# без обоих токенов приём выключен.
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
# RAG_UPLOAD_TOKEN=...

# --- Добавлено: остальные переменные, которые читает код (все необязательные) ---

# Ключ API эмбеддингов (только если embedding.provider: openai)
# RAG_EMBEDDING_API_KEY=

# Куда fastembed кэширует скачанные модели (по умолчанию — папка в профиле пользователя)
# FASTEMBED_CACHE_PATH=
# Потоки процессора для эмбеддингов (0 — все ядра); приоритет у embedding.threads из config.yaml
# RAG_EMBED_THREADS=0

# Разрешить MCP по HTTP без токена. ОПАСНО: только на 127.0.0.1 или за файрволом
# RAG_MCP_ALLOW_NO_AUTH=1

# Переопределения config.yaml через окружение (имеют приоритет над файлом)
# RAG_BACKEND=none
# RAG_HTTP_BASE_URL=
# RAG_HTTP_USERNAME=
# RAG_HTTP_AUTH=basic
# RAG_HTTP_TIMEOUT=60
# RAG_COM_CONNECTION_STRING=
# RAG_COM_PROG_ID=V83.COMConnector
# RAG_CODE_DIR=
# RAG_KNOWLEDGE_DIR=
# RAG_LLM_PROVIDER=lmstudio
# RAG_LLM_MODEL=
# RAG_LLM_BASE_URL=
